# Contact endpoint. The site is static (GitHub Pages); the chat widget POSTs the
# captured lead here. Point it at the Groway backend's public gateway:
#   VITE_CONTACT_ENDPOINT=https://api.groway.studio/public/contact
# When unset, the widget falls back to opening a pre-filled mailto: draft.
# Set it as a repository Actions variable for production builds.
VITE_CONTACT_ENDPOINT=

# Cloudflare Turnstile sitekey (invisible mode) — anti-abuse for the contact
# endpoint. When set, the widget attaches a token the backend verifies. When
# absent, submissions proceed without a challenge. Public value, safe to expose.
VITE_TURNSTILE_SITEKEY=
